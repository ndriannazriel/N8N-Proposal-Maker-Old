    {
      "parameters": {
        "jsCode": "// Expecting the Structured/Auto-fixed parser to put the config at items[0].json.output\nconst cfg = items[0].json.output;\n\n// 1) Basic shape checks + coercions\nif (!cfg || typeof cfg !== 'object') {\n  throw new Error('Chart config missing.');\n}\ncfg.type = cfg.type || 'bar';\ncfg.data = cfg.data || {};\ncfg.data.labels = Array.isArray(cfg.data.labels) ? cfg.data.labels.map(String) : [];\ncfg.data.datasets = Array.isArray(cfg.data.datasets) ? cfg.data.datasets : [];\n\n// 2) If labels empty but dataset exists with data length -> create labels 1..N\nif (cfg.data.labels.length === 0 && cfg.data.datasets[0]?.data?.length > 0) {\n  const n = cfg.data.datasets[0].data.length;\n  cfg.data.labels = Array.from({ length: n }, (_, i) => String(i + 1));\n}\n\n// 3) Coerce dataset data to numbers & trim/pad to labels length\ncfg.data.datasets = cfg.data.datasets.map(ds => {\n  const data = Array.isArray(ds.data) ? ds.data : [];\n  const asNum = data.map(v => Number(v)).filter(v => Number.isFinite(v));\n  const m = Math.min(asNum.length, cfg.data.labels.length);\n  return {\n    label: ds.label || 'Series',\n    data: asNum.slice(0, m)\n  };\n}).filter(ds => ds.data.length > 0);\n\n// 4) Final sanity\nif (cfg.data.labels.length === 0 || cfg.data.datasets.length === 0) {\n  // Minimal fallback to avoid QuickChart errors\n  cfg.type = 'bar';\n  cfg.data = {\n    labels: ['A','B','C'],\n    datasets: [{ label: 'Series', data: [1,2,3] }]\n  };\n  cfg.options = { scales: { y: { beginAtZero: true } } };\n}\n\n// Put back for the next node\nreturn [{ json: { output: cfg } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -64
      ],
      "id": "3429d7bc-9715-4d28-82fb-4e694df032d9",
      "name": "Add a tiny validator/coercer before QuickChart (Code node)2"
    },
